# Pinned upstream engine used by the release build.
#
# wxdl installs exactly this version unless the user runs `wxdl update --follow`.
# The checksums below are copied from the upstream release's own
# wx_video_download_<tag>_checksums.txt file; the build fails if the downloaded
# asset does not match, so a tampered or renamed upstream asset can never be
# shipped inside a wxdl release.

UPSTREAM_REPO="ltaoo/wx_channels_download"
UPSTREAM_TAG="v260907"
UPSTREAM_ASSET_PREFIX="wx_video_download"

